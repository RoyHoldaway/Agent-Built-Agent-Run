---
import Base from '../layouts/Base.astro';
import BookingWidget from '../components/BookingWidget.astro';

export const prerender = true;
---
<Base title="Book an appointment" description="Pick a service, day and time.">
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold">Book an appointment</h1>
    <p class="mt-2 text-muted">Choose a service, then an open day and time.</p>
    <div class="mt-8"><BookingWidget /></div>
  </section>
</Base>
