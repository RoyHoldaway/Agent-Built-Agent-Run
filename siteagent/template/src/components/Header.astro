---
import config from '../../site.config.json';
const path = Astro.url.pathname;
---
<header class="sticky top-0 z-30 border-b border-line bg-surface/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4">
    <a href="/" class="font-display text-lg font-bold">{config.business.name}</a>
    <nav aria-label="Main" class="flex items-center gap-1 text-sm">
      {config.nav.map((item) => (
        <a
          href={item.href}
          aria-current={path === item.href ? 'page' : undefined}
          class="rounded-control px-3 py-2 text-muted hover:text-ink aria-[current=page]:text-ink aria-[current=page]:font-semibold"
        >{item.label}</a>
      ))}
    </nav>
  </div>
</header>
