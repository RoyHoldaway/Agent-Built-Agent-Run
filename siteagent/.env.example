# --- Where Qwen lives (any OpenAI-compatible server) ---
# Ollama (default):   http://localhost:11434/v1
# LM Studio:          http://localhost:1234/v1
# vLLM / llama.cpp:   http://localhost:8000/v1
# Alibaba DashScope:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama

# Text model writes the code. Vision model reads the sketches. (Can be the same model if it is multimodal.)
QWEN_TEXT_MODEL=qwen3-coder:30b
QWEN_VISION_MODEL=qwen3-vl:8b

# Optional tuning
QWEN_TEMPERATURE=0.2
QWEN_MAX_TOKENS=16000
QWEN_TIMEOUT=900
SITEAGENT_MAX_REPAIRS=3
